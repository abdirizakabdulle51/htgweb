DATABASE_URL="postgresql://postgres:replace-with-database-password@localhost:5432/htgclouds"
JWT_SECRET="replace-with-secure-random-secret"
CLIENT_URL="http://localhost:5180"
SERVER_PORT=4001
# Local development API base. Production builds default to https://htgweb.onrender.com if unset.
VITE_API_BASE_URL="http://localhost:4001"

# Outbound email (Google Workspace SMTP). Without these set, verification
# codes and reset links are just logged to the console instead of emailed.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="noreply@htgclouds.com"
SMTP_PASS="replace-with-google-app-password"
SMTP_FROM_NAME="HTG Clouds"
SMTP_FROM_EMAIL="noreply@htgclouds.com"
# Shared secret for the internal CRM -> htgweb email relay endpoint.
MAIL_RELAY_SECRET=

# ManageOne tenant provisioning. Disabled unless explicitly enabled on staging
# or production after the required network and credential checks pass.
MANAGEONE_ENABLED=false
MANAGEONE_USERNAME=
MANAGEONE_PASSWORD=
MANAGEONE_AUTH_BASE_URL=https://10.20.24.9:26335
MANAGEONE_AUTH_DOMAIN=mo_bss_admin
MANAGEONE_BASE_URL=https://10.20.24.9:26335/rest/vdc
# Region profile: hoa keeps the existing onboarding path, hq3 provisions only
# Mogadishu-region-hq3, and both binds new tenants to HOA and HQ3 together.
MANAGEONE_REGION_PROFILE=hoa
MANAGEONE_REGION_ID=hoa-mogadishu-2
MANAGEONE_CLOUD_INFRA_ID=FUSION_CLOUD_hoa-mogadishu-2
MANAGEONE_AZ_KVM=az1.cls
MANAGEONE_AZ_BMS=az2.cls
MANAGEONE_HQ3_REGION_ID=htgcloud-region-02
MANAGEONE_HQ3_CLOUD_INFRA_ID=FUSION_CLOUD_htgcloud-region-02
MANAGEONE_HQ3_AZ_KVM=az1.hq3
MANAGEONE_HQ3_AZ_BMS=az2.hq3
MANAGEONE_UPPER_VDC_ID=0
MANAGEONE_ALLOCATE_EXTERNAL_NETWORKS=false
MANAGEONE_EXTERNAL_NETWORK_USERNAME=
MANAGEONE_EXTERNAL_NETWORK_PASSWORD=
MANAGEONE_EXTERNAL_NETWORK_AUTH_DOMAIN=mo_bss_admin
MANAGEONE_BIND_USER_CONTACT=true
MANAGEONE_ENABLE_USER_MFA=false
MANAGEONE_VPC_EXTERNAL_NETWORK_ID=e5f48527-06ab-4f2a-be05-6f21e968c945
MANAGEONE_VPC_EXTERNAL_NETWORK_NAME=dummy_external_network
MANAGEONE_EIP_EXTERNAL_NETWORK_ID=b79700e5-6929-4a46-ae16-93a29999b3d2
MANAGEONE_EIP_EXTERNAL_NETWORK_NAME=eip_external
MANAGEONE_HQ3_VPC_EXTERNAL_NETWORK_ID=b24abfa6-5e67-4aea-ac3e-4897b7c1bd59
MANAGEONE_HQ3_VPC_EXTERNAL_NETWORK_NAME=dummy_external_network
MANAGEONE_HQ3_EIP_EXTERNAL_NETWORK_ID=f7626aa4-cfcf-4994-8295-f60516945c26
MANAGEONE_HQ3_EIP_EXTERNAL_NETWORK_NAME=eip_external
MANAGEONE_TIMEOUT_MS=30000
MANAGEONE_TLS_REJECT_UNAUTHORIZED=false

# Optional CRM sync target for the nightly ManageOne tenant sync job.
# Real values belong only in the server .env.
CRM_SYNC_URL=
CRM_SYNC_SECRET=

# Weekly AI recommendation narrative generation. Real values belong only in
# the server .env.
AI_RECS_SYNC_SECRET=
OPENAI_API_KEY=
CLOUD_HEALTH_SYNC_SECRET=
TENANT_HISTORY_SYNC_SECRET=

# ManageOne OC alarm sync to CRMV2 Cloud Health. Real values belong only in
# the server .env.
MANAGEONE_ALARMS_SYNC_SECRET=
CRM_ALARMS_SYNC_URL=https://crm-api.102-203-134-106.sslip.io/cloud-alarms/sync
MANAGEONE_ALARMS_BASE_URL=https://oc.htgclouds.com:26335
MANAGEONE_ALARM_SEVERITIES=1,2

# ManageOne host group utilization sync to CRMV2 Cloud Health. Real values
# belong only in the server .env.
HOST_GROUPS_SYNC_SECRET=
CRM_HOST_GROUPS_SYNC_URL=https://crm-api.102-203-134-106.sslip.io/cloud-host-groups/sync

# ManageOne hourly monitoring snapshots. This is read-only monitoring data and
# does not create invoices or billing rows. Leave the tenant filter as dss
# while testing; use __all__ only after the flow is approved for all tenants.
MANAGEONE_HOURLY_MONITORING_TENANT_FILTER=dss
MANAGEONE_HOURLY_MONITORING_REGION_FILTER=hoa,hq3
MANAGEONE_HOURLY_MONITORING_NAT_GATEWAYS=true
MANAGEONE_HOURLY_MONITORING_DELAY_MS=1000
MANAGEONE_HOURLY_MONITORING_TIMEOUT_MS=30000
MANAGEONE_CAPACITY_BASE_URL=https://10.20.24.9:26335
MANAGEONE_HOURLY_SYNC_URL=https://staging-crm-actions.102-203-134-2.sslip.io/manageone-hourly/sync
MANAGEONE_HOURLY_SYNC_SECRET=
