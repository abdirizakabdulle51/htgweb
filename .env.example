DATABASE_URL="postgresql://postgres:replace-with-database-password@localhost:5432/htgclouds"
JWT_SECRET="replace-with-secure-random-secret"
CLIENT_URL="http://localhost:5180"
SERVER_PORT=4001
# Local development API base. Production builds default to https://htgweb.onrender.com if unset.
VITE_API_BASE_URL="http://localhost:4001"

# Outbound email (Google Workspace SMTP). Without these set, verification
# codes and reset links are just logged to the console instead of emailed.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="noreply@htgclouds.com"
SMTP_PASS="replace-with-google-app-password"
SMTP_FROM_NAME="HTG Clouds"
SMTP_FROM_EMAIL="noreply@htgclouds.com"
